{
  "name": "@pmwdigital/kvkk-maske",
  "version": "0.1.0",
  "description": "Kişisel verileri dil modeline göndermeden önce yer tutucularla değiştirir, modelin cevabında aslına döndürür",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmwdigital/pmw-kvkk-maske.git"
  },
  "keywords": [
    "kvkk",
    "pii",
    "llm",
    "maskeleme",
    "tckn",
